# LM Studio — API OpenAI-compatible
# Mesmo PC que corre Docker: http://host.docker.internal:1234/v1
#   (ex.: LM Studio em 192.168.10.131 — URL LAN para outros dispositivos,
#    mas o container Docker deve usar host.docker.internal)
# Outro host na LAN: http://<IP-LM-STUDIO>:1234/v1
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=microsoft/phi-4
LM_STUDIO_API_KEY=lm-studio

# Healthcheck service
HEALTHCHECK_PORT=8080
HEALTHCHECK_HOST=0.0.0.0

# Agent API (web UI Fase 1)
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8090
HEALTHCHECK_URL=http://127.0.0.1:8080
# Set by agent-api by default — skills do not open the host browser
# FRIDAY_NO_BROWSER=1

# Fase 1 — Voice pipeline (Windows host native)
LM_STUDIO_BASE_URL_HOST=http://localhost:1234/v1
LM_STUDIO_MODEL=microsoft/phi-4
# VLM no LM Studio (llava, qwen2-vl, pixtral, phi-4-multimodal, …). Vazio = auto-detect (prefere VLMs leves).
# LM_STUDIO_VISION_MODEL=moondream-2b-text
LLM_VISION_ENABLED=true
LLM_VISION_PING_TTL_SECONDS=300
# Planner: off | hint | aggressive
LLM_PLANNER_MODE=aggressive
LLM_PLANNER_MAX_PER_MINUTE=12
LM_STUDIO_API_KEY=lm-studio
WAKE_KEYWORD=hey_jarvis
WAKE_THRESHOLD=0.65
WAKE_MODEL_PATH=
WAKE_INFERENCE_FRAMEWORK=onnx
# wake | speech | enter (mic) | text (sem mic — escreve, responde por voz)
VOICE_TRIGGER=text
RECORD_POST_WAKE_MS=500
# Nome parcial ou indice numerico — preferencia WASAPI automatica
# Ex.: AUDIO_INPUT_DEVICE=1  (Realtek MME) | AUDIO_OUTPUT_DEVICE=Realtek
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=Realtek
WEBRTC_VAD_MODE=3
WEBRTC_SILENCE_MS=2000
PREPROC_HIGHPASS_HZ=100
WHISPER_MODEL=small
# cuda | cpu — no agent-api, CUDA so e usado com FRIDAY_WHISPER_CUDA=1
# (sem cublas64_*.dll o processo bloqueava a UI inteira)
WHISPER_DEVICE=cpu
# FRIDAY_WHISPER_CUDA=1
# Voz feminina britanica (Cori). Para PT-EU: models/piper/pt_PT-tugao-medium.onnx
PIPER_VOICE=models/piper/en_GB-cori-high.onnx
PIPER_EXECUTABLE=
# Velocidade Piper: 1.0 = normal; ~0.95–1.05 ≈ 150–170 wpm
PIPER_LENGTH_SCALE=1.0
# Tratamento formal no system prompt (PT). Em ingles a FRIDAY usa "Sir".
FRIDAY_USER_ADDRESS=Senhor
MAX_CONTEXT_MESSAGES=20
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_ROUNDS=4
MAX_RECORD_SECONDS=15
MIN_AUDIO_DB=-60
VAD_SILENCE_DB=-45
SPEECH_START_DB=-55
RECORD_SILENCE_MS=1200
SAMPLE_RATE=16000
WORLD_MONITOR_URL=
FINANCE_MONITOR_URL=
NEWS_WORLD_FEEDS=
NEWS_FINANCE_FEEDS=
WEB_SEARCH_MAX_RESULTS=5
# true = factos actuais exigem search/fetch e citacao; sem fontes, recusa inventar
WEB_SOURCE_REQUIRED=true
LLM_CONTEXT_TOKEN_BUDGET=6000
# Fallback OpenAI-compatible (Ollama default :11434/v1 ou llama-server)
# LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
# LLM_FALLBACK_MODEL=qwen2.5:7b-instruct
# LLM_FALLBACK_API_KEY=ollama
SESSIONS_DIR=data/sessions
FEEDBACK_PATH=data/feedback/feedback.jsonl
PREFS_DIR=data/prefs
# false = briefing + pergunta "Queres que abra o mapa?"; true = abre automaticamente
AUTO_OPEN_MONITORS=false

# Fase 5 — Document RAG (separate from personal memory in data/chroma/)
RAG_ENABLED=true
RAG_BACKEND=embedding
# Short id or full HF id both work (normalized at runtime)
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CORPUS_PATH=friday-llm/data/rag/chunks.jsonl
RAG_INDEX_DIR=data/rag_chroma
RAG_TOP_K=4

# Fase 6 — GGUF export (opcional)
# LLAMA_CPP_PATH=C:/llama.cpp

ERROR_NETWORK_PT=Nao consegui ligar ao modelo. Tenta outra vez.
ERROR_NO_AUDIO_PT=Nao percebi. Podes repetir?
ERROR_GENERIC_PT=Ocorreu um erro. Tenta outra vez.
ERROR_TIMEOUT_PT=Demorei demasiado a pensar.
ERROR_MODEL_PT=O modelo de linguagem nao esta carregado. Abre o LM Studio e carrega um modelo.
VOICE_PUSH_TO_TALK=false
WHISPER_VAD_FILTER=false
