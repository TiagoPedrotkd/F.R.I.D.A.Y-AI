# Exemplo Bionic (LM Studio): D:\Models\LM_STUDIO\Bionic\Bionic.exe
$LmStudioExe = "D:\Models\LM_STUDIO\Bionic\Bionic.exe"

# Pasta do repo FRIDAY (default: auto-detectado pelo script)
# $RepoPath = "D:\Repositories\F.R.I.D.A.Y-AI"

# Fase 3 — se true, friday-start sobe profiles mqtt + homeassistant
